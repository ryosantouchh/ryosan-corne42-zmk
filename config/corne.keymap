#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        J5: J5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N5 &kp J>;
            label = "J5";
        };

        K5: K5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N5 &kp K>;
            label = "K5";
        };
    };

    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <128>;
            hold-trigger-key-positions = <6 18 30 31 19 7 8 20 32 33 21 9 10 22 34 35 23 11 36 37 38 39 40 41>;
            hold-trigger-on-release;
        };

        hm_r: hm_r {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <128>;
            hold-trigger-key-positions = <36 37 38 39 40 41 29 17 5 4 16 28 27 15 3 2 14 26 25 13 1 0 12 24>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp ESC    &kp Q              &kp W  &kp E         &kp R         &kp T          &kp Y         &kp U  &kp I          &kp O    &kp P                        &kp BSPC
&kp TAB    &hml LEFT_SHIFT A  &kp S  &kp D         &kp F         &hml CAPS G    &hm_r CAPS H  &kp J  &kp K          &kp L    &hm_r RIGHT_SHIFT SEMICOLON  &kp ENTER
&kp LCTRL  &kp Z              &kp X  &kp C         &kp V         &kp B          &kp N         &kp M  &kp COMMA      &kp DOT  &kp FSLH                     &kp GRAVE
                                     &kp LEFT_ALT  &kp LEFT_GUI  &kp SPACE      &mo 1         &mo 2  &kp RIGHT_ALT
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp ESC             &kp EXCL  &kp AT_SIGN  &kp HASH              &kp DOLLAR             &kp PERCENT    &kp CARET         &kp AMPERSAND     &kp ASTERISK       &kp MINUS  &kp EQUAL      &kp BSPC
&kp CAPS            &none     &none        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &K5            &kp SINGLE_QUOTE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp PIPE   &kp COLON      &kp ENTER
&mt LEFT_SHIFT TAB  &none     &none        &none                 &kp GRAVE              &J5            &kp UNDERSCORE    &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp DOT    &kp BACKSLASH  &kp RIGHT_SHIFT
                                           &mt LEFT_ALT LCTRL    &kp LEFT_GUI           &kp SPACE      &trans            &trans            &kp RALT
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp ESCAPE          &kp NUMBER_1    &kp NUMBER_2  &kp NUMBER_3        &kp NUMBER_4  &kp N5          &kp NUMBER_6    &kp N7          &kp N8         &kp N9           &kp N0         &kp BACKSPACE
&kp CAPS            &kp LEFT_SHIFT  &none         &none               &none         &mo 3           &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW   &kp RIGHT_ARROW  &kp PAGE_UP    &kp HOME
&mt LEFT_SHIFT TAB  &bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1        &bt BT_SEL 2  &bt BT_SEL 4    &none           &none           &none          &kp PRINTSCREEN  &kp PAGE_DOWN  &kp END
                                                  &mt LEFT_ALT LCTRL  &kp LEFT_GUI  &kp SPACE       &trans          &trans          &kp RIGHT_ALT
            >;
        };

        function {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5    &kp F6   &kp F7   &kp F8  &kp F9  &kp F10  &none
&trans  &none   &none   &none   &none   &none     &kp F11  &kp F12  &none   &none   &none    &none
&trans  &none   &none   &none   &none   &trans    &none    &none    &none   &none   &none    &trans
                        &trans  &trans  &trans    &trans   &trans   &trans
            >;
        };
    };
};
